# reset
# ----------------------------------------------------------------------------

def cmd_reset(args):
    need_root()
    fans, cpu, gpu = hw()
    orig = STATE.data.get("original", {})
    msgs = []

    for key, val in list(orig.items()):
        try:
            if key.startswith("rapl|"):
                _, dom, idx = key.split("|")
                wr(POWERCAP / dom / f"constraint_{idx}_power_limit_uw", val)
                msgs.append(f"{dom} constraint {idx} -> {val/1_000_000:.1f} W")
            elif key == "max_perf_pct":
                wr(PSTATE / "max_perf_pct", val); msgs.append(f"max_perf_pct -> {val}")
            elif key == "no_turbo":
                wr(PSTATE / "no_turbo", val); msgs.append(f"no_turbo -> {val}")
            elif key == "governor":
                cpu.set_governor(val); msgs.append(f"governor -> {val}")
            elif key == "epp":
                cpu.set_epp(val); msgs.append(f"epp -> {val}")
            elif key == "platform_profile":
                wr(PLATFORM_PROFILE, val); msgs.append(f"platform_profile -> {val}")
            elif key == "fan_custom_speed_pct":
                fans.set_speed_pct(val); msgs.append(f"fan custom speed -> {val}%")
            elif key == "gpu_boost":
                wr(AORUS / "gpu_boost", val); msgs.append(f"gpu_boost -> {val}")
            elif key == "charge_mode":
                wr(AORUS / "charge_mode", val); msgs.append(f"charge_mode -> {val}")
            elif key == "charge_limit":
                wr(AORUS / "charge_limit", val); msgs.append(f"charge_limit -> {val}")
        except Err as e:
            msgs.append(f"! {key}: {e}")

    # Fan mode last, so the fans are never left in a custom mode with a stale
    # duty. Only when we recorded one: reset undoes this tool's own changes, and
    # forcing "normal" on a machine it never touched would override a mode the
    # user or the firmware set. `aorusctl fan auto` is the explicit way to hand
    # the fans back.
    if fans.available and "fan_mode" in orig:
        try:
            fans.set_mode(orig["fan_mode"])
            msgs.append(f"fan mode -> {orig['fan_mode']}")
        except Err as e:
            msgs.append(f"! fan mode: {e}")

    # Only if we actually changed something on the GPU. Unlocking clocks or
    # restoring a power limit we never set would override whatever the user had.
    gpu_touched = ("gpu_power_limit" in orig or "gpu_persistence" in orig
                   or STATE.current("gpu_clocks") is not None)
    if gpu.available and gpu_touched:
        msgs += gpu.reset()
        if STATE.original("gpu_persistence") == 0 and not DRY_RUN:
            if run([gpu.smi, "-pm", "0"]):
                msgs.append("GPU persistence mode -> off")

    if not DRY_RUN:
        STATE.data = {}
        STATE.save()
    print("Restored:")
    for m in msgs:
        print("  " + m)
    if not msgs:
        print("  nothing to undo - no recorded changes")
    return 0


# ----------------------------------------------------------------------------
# daemon: software fan curve + thermal guard
# ----------------------------------------------------------------------------

_daemon_stop = threading.Event()


def curve_speed(curve, t):
    """Duty for a temperature, linearly interpolated between curve points.

    `curve` is a sorted list of (temperature, duty) pairs. Below the first point
    and above the last one the curve is flat.
    """
    if not curve:
        return 0.0
    if t <= curve[0][0]:
        return curve[0][1]
    if t >= curve[-1][0]:
        return curve[-1][1]
    for i in range(1, len(curve)):
        t0, s0 = curve[i - 1]
        t1, s1 = curve[i]
        if t <= t1:
            if t1 == t0:
                return s1
            return s0 + (s1 - s0) * (t - t0) / (t1 - t0)
    return curve[-1][1]


def daemon_target(curve, t, applied, *, hysteresis=3.0, guard_temp=92.0,
                  guard_speed=100.0, min_speed=0.0):
    """The duty the daemon should ask for, as a whole percentage.

    Above `guard_temp` the curve is ignored and the floor is dropped, so the
    guard can always reach full speed. Below it, duty only comes back down once
    the temperature has fallen by `hysteresis` degrees, which stops the fans
    hunting around a curve point.
    """
    want = guard_speed if t >= guard_temp else curve_speed(curve, t)
    if applied is not None and want < applied and t < guard_temp:
        if curve_speed(curve, t + hysteresis) >= applied:
            want = applied
    floor = min_speed if t < guard_temp else 0
    return int(round(clamp(want, floor, 100)))


def _restore_on_exit():
    try:
        fans = hw()[0]
        if fans.available:
            duty = STATE.original("fan_custom_speed_pct")
            if duty is not None:
                fans.set_speed_pct(duty)
            target = STATE.original("fan_mode") or "normal"
            fans.set_mode(target)
            sys.stderr.write(f"[aorusctld] restored fan mode to {target}\n")
    except Exception as e:
        sys.stderr.write(f"[aorusctld] restore failed: {e}\n")


def cmd_daemon_cleanup(args):
    """ExecStopPost hook. Hands the fans back to the firmware unless the daemon
    stood down on purpose, in which case the mode the user picked is left alone."""
    if YIELD_FLAG.exists():
        mode = rd(YIELD_FLAG, "").strip()
        YIELD_FLAG.unlink(missing_ok=True)
        print(f"aorusctld stood down; leaving fan mode at {mode or 'your choice'}")
        return 0
    fans = hw()[0]
    if not fans.available:
        return 0
    target = STATE.original("fan_mode") or "normal"
    try:
        fans.set_mode(target)
        print(f"fan mode -> {target}")
    except Err as e:
        sys.stderr.write(f"aorusctl: {e}\n")
    return 0


def cmd_daemon(args):
    need_root()
    cfg = load_config()
    d = cfg["daemon"]
    fans, cpu, gpu = hw()
    if not fans.available:
        raise Err("fan driver unavailable: " + fans.why_unavailable())

    curve = sorted((float(t), float(s)) for t, s in d["curve"])
    interval = float(d.get("interval", 2.0))
    hyst = float(d.get("hysteresis", 3.0))
    guard_t = float(d.get("guard_temp", 92))
    guard_s = float(d.get("guard_speed", 100))
    min_s = float(d.get("min_speed", 0))

    for sig in (signal.SIGTERM, signal.SIGINT):
        try:
            signal.signal(sig, lambda *_: _daemon_stop.set())
        except ValueError:
            pass   # not the main thread; the caller owns shutdown

    STATE.remember("fan_mode", fans.mode() or "normal")
    fans.set_mode("fixed")
    applied = None
    yielded = False
    YIELD_FLAG.unlink(missing_ok=True)
    peak = 0.0
    sys.stderr.write(f"[aorusctld] curve {curve} interval {interval}s "
                     f"guard {guard_t}C floor {min_s}%\n")

    try:
        snapshot()
        while not _daemon_stop.is_set():
            s = snapshot()
            temps = [x for x in (s["cpu"]["package_c"], s["gpu"].get("temp_c"),
                                 s["fan"]["ec_temps"].get("cpu"), s["fan"]["ec_temps"].get("gpu"))
                     if x]
            t = max(temps) if temps else 0.0
            peak = max(peak, t)

            want = daemon_target(curve, t, applied, hysteresis=hyst,
                                 guard_temp=guard_t, guard_speed=guard_s,
                                 min_speed=min_s)

            # Reassert every tick, not only when the target duty changes. The old
            # behaviour let an external `fan mode normal` stand until the
            # temperature happened to move, so the fans looked like they flipped
            # back to fixed at random minutes later.
            mode_now = fans.mode()
            if mode_now != "fixed":
                # Somebody picked a mode. That is an explicit instruction, so the
                # daemon steps aside instead of overwriting it two seconds later.
                sys.stderr.write(f"[aorusctld] fan mode was set to {mode_now} outside "
                                 f"the daemon, so the daemon is standing down and "
                                 f"leaving the fans alone.\n")
                yielded = True
                try:
                    YIELD_FLAG.write_text(mode_now)
                except OSError:
                    pass
                break

            if want != applied:
                try:
                    fans.set_speed_pct(want)
                    if fans.mode() != "fixed":
                        fans.set_mode("fixed")
                    applied = want
                    log(f"{t:.0f}C -> fan {want}%")
                except Err as e:
                    sys.stderr.write(f"[aorusctld] {e}\n")

            _daemon_stop.wait(interval)
    finally:
        if not yielded:
            _restore_on_exit()
        else:
            sys.stderr.write("[aorusctld] leaving the fans as you set them.\n")
    return 0


