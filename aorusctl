def build_parser():
    p = argparse.ArgumentParser(
        prog="aorusctl",
        description="Fan, CPU and GPU control plus dashboards for Gigabyte AORUS laptops.",
        epilog="Everything is reversible: `sudo aorusctl reset` puts back every value it changed.")
    p.add_argument("--dry-run", action="store_true", help="print writes instead of performing them")
    p.add_argument("-v", "--verbose", action="store_true")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status", help="one-shot snapshot")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("mon", help="live terminal dashboard")
    s.add_argument("-i", "--interval", type=float, default=1.0)
    s.set_defaults(func=cmd_mon)

    s = sub.add_parser("web", help="live dashboard in a browser")
    s.add_argument("--port", type=int, default=8787)
    s.add_argument("--bind", default="127.0.0.1")
    s.set_defaults(func=cmd_web)

    s = sub.add_parser("fan", help="fan mode, fixed duty, firmware curve")
    s.add_argument("fan_cmd", choices=["show", "mode", "speed", "curve", "auto", "charge-limit"])
    s.add_argument("value", nargs="?",
                   help="mode: %s | speed: 0-100 | curve: 45:20,55:35,70:60,...  | charge-limit: 60-100"
                        % "/".join(FAN_MODES))
    s.set_defaults(func=cmd_fan)

    s = sub.add_parser("cpu", help="package power limits and frequency ceiling")
    s.add_argument("cpu_cmd", choices=["show", "pl1", "pl2", "maxpct", "turbo", "governor", "epp", "platform"])
    s.add_argument("value", nargs="?")
    s.set_defaults(func=cmd_cpu)

    s = sub.add_parser("gpu", help="nvidia power limit and clock ceiling")
    s.add_argument("gpu_cmd", choices=["show", "limit", "clocks", "reset", "boost"])
    s.add_argument("value", nargs="?")
    s.set_defaults(func=cmd_gpu)

    s = sub.add_parser("profile", help="apply a named bundle from the config file")
    s.add_argument("profile_cmd", choices=["list", "show", "apply"])
    s.add_argument("name", nargs="?")
    s.set_defaults(func=cmd_profile)

    s = sub.add_parser("daemon", help="software fan curve with a thermal guard")
    s.set_defaults(func=cmd_daemon)

    s = sub.add_parser("daemon-cleanup",
                       help="internal: ExecStopPost hook for aorusctld.service")
    s.set_defaults(func=cmd_daemon_cleanup)

    s = sub.add_parser("reset", help="undo every change this tool has made")
    s.set_defaults(func=cmd_reset)

    s = sub.add_parser("probe", help="write a read-only hardware report")
    s.add_argument("-o", "--output")
    s.set_defaults(func=cmd_probe)

    s = sub.add_parser("version", help="version and detected backends")
    s.set_defaults(func=cmd_version)
    return p


def main(argv=None):
    global DRY_RUN, VERBOSE
    args = build_parser().parse_args(argv)
    DRY_RUN = args.dry_run
    VERBOSE = args.verbose

    needs_value = {
        "fan": ("fan_cmd", ("mode", "speed", "curve", "charge-limit")),
        "cpu": ("cpu_cmd", ("pl1", "pl2", "maxpct", "turbo", "governor", "epp", "platform")),
        "gpu": ("gpu_cmd", ("limit", "clocks", "boost")),
        "profile": ("profile_cmd", ("show", "apply")),
    }
    if args.cmd in needs_value:
        attr, requiring = needs_value[args.cmd]
        vattr = "name" if args.cmd == "profile" else "value"
        if getattr(args, attr) in requiring and not getattr(args, vattr):
            sys.stderr.write(f"aorusctl: `{args.cmd} {getattr(args, attr)}` needs a value\n")
            return 2

    try:
        try:
            apply_config_globals(load_config())
        except Err:
            pass          # a broken config must not stop you reading the sensors
        return args.func(args) or 0
    except Err as e:
        sys.stderr.write(f"aorusctl: {e}\n")
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
