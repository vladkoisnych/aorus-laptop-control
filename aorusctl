def cmd_fan(args):
    fans = hw()[0]
    if args.fan_cmd == "show":
        if not fans.available:
            print("fan driver unavailable: " + fans.why_unavailable())
            return 1
        print(f"mode          {fans.mode()}")
        print(f"custom duty   {fmt(fans.custom_speed_pct(), ' %')}   "
              f"(100% = EC value {FAN_DUTY_MAX})")
        print(f"current duty  {fmt(fans.pwm_pct(), ' %')}")
        print(f"rpm           " + ("  ".join(f"{k}:{v}" for k, v in fans.rpms().items()) or "--"))
        pts = fans.curve()
        if pts:
            print("firmware curve (temp C -> duty)")
            for i, (t, s) in enumerate(pts):
                print(f"  [{i:2}]  {t:3} C  ->  {s:3} %")
        return 0
    need_root()
    if not fans.available:
        raise Err(fans.why_unavailable())
    note = yield_daemon(f"you ran `fan {args.fan_cmd}`")
    if note:
        print(note)
    if args.fan_cmd == "mode":
        fans.set_mode(args.value)
        print(f"fan mode -> {args.value}")
    elif args.fan_cmd == "speed":
        pct = int(args.value)
        fans.set_speed_pct(pct)
        if fans.mode() not in ("fixed", "auto"):
            fans.set_mode("fixed")
        print(f"fans fixed at {pct}%  (mode {fans.mode()})")
    elif args.fan_cmd == "curve":
        pts = []
        for chunk in args.value.split(","):
            chunk = chunk.strip()
            if not chunk:
                continue
            t, sep, sp = chunk.partition(":")
            if not sep or not t.strip().lstrip("-").isdigit() \
                    or not sp.strip().lstrip("-").isdigit():
                raise Err(
                    f"could not read {chunk!r} as a curve point.\n"
                    f"  Expected temperature:duty pairs separated by commas, "
                    f"for example:\n"
                    f"    45:15,55:25,65:40,72:55,80:70,86:85,92:100")
            pts.append((int(t), int(sp)))
        if not pts:
            raise Err("no curve points given")
        fans.set_curve(pts)
        fans.set_mode("custom")
        print(f"wrote {len(pts)} curve points and switched to custom mode")
    elif args.fan_cmd == "auto":
        fans.set_mode("normal")
        print("fan mode -> normal (firmware control)")
    elif args.fan_cmd == "charge-limit":
        fans.set_charge_limit(int(args.value))
        print(f"charge limit -> {args.value}%")
    return 0


def cmd_cpu(args):
    cpu = hw()[1]
    if args.cpu_cmd == "show":
        for k in cpu.constraints():
            cap = f"max {k['max_w']:6.1f} W" if k["max_w"] else "max not published"
            print(f"{k['domain']:<22} {k['name']:<12} {k['limit_w']:6.1f} W   {cap:<20}"
                  f"   window {k['window_us']} us")
        print(f"governor      {cpu.governor()}   available: {', '.join(cpu.governors())}")
        print(f"epp           {cpu.epp()}   available: {', '.join(cpu.epps())}")
        print(f"perf window   {cpu.min_perf_pct()}-{cpu.max_perf_pct()} %")
        t = cpu.turbo()
        print(f"turbo         {('on' if t else 'off') if t is not None else 'unknown'}")
        pp = cpu.platform_profile()
        if pp:
            print(f"platform      {pp}   available: {', '.join(cpu.platform_profiles())}")
        return 0
    need_root()
    if args.cpu_cmd == "pl1":
        for m in cpu.set_pl1(float(args.value)):
            print(m)
    elif args.cpu_cmd == "pl2":
        for m in cpu.set_pl2(float(args.value)):
            print(m)
    elif args.cpu_cmd == "maxpct":
        cpu.set_max_perf_pct(int(args.value)); print(f"max_perf_pct -> {args.value}")
    elif args.cpu_cmd == "turbo":
        on = args.value.lower() in ("on", "1", "true", "yes")
        cpu.set_turbo(on); print(f"turbo -> {'on' if on else 'off'}")
    elif args.cpu_cmd == "governor":
        n = cpu.set_governor(args.value); print(f"governor -> {args.value} on {n} cpus")
    elif args.cpu_cmd == "epp":
        n = cpu.set_epp(args.value); print(f"epp -> {args.value} on {n} cpus")
    elif args.cpu_cmd == "platform":
        cpu.set_platform_profile(args.value); print(f"platform profile -> {args.value}")
    return 0


def cmd_gpu(args):
    gpu = hw()[2]
    if args.gpu_cmd == "show":
        q = gpu.query()
        if not q:
            raise Err("nvidia-smi returned nothing (is the dGPU powered / driver loaded?)")
        for k, v in q.items():
            print(f"{k:<24} {v}")
        print(f"{'enforced limit (read back)':<24} {gpu.enforced_limit_w()}")
        print(f"{'persistence mode':<24} {'on' if gpu.persistence_on() else 'off'}")
        print(f"{'nvidia-powerd':<24} {gpu.powerd_state()}")
        d = gpu.power_detail()
        if d:
            print("\nnvidia-smi -q -d POWER:")
            for k, v in d.items():
                print(f"  {k:<32} {v}")
        return 0
    need_root()
    if args.gpu_cmd == "limit":
        print(gpu.set_power_limit(float(args.value)))
    elif args.gpu_cmd == "clocks":
        lo, hi = (args.value.split(",") + [args.value])[:2]
        print(gpu.set_clocks(int(lo), int(hi)))
    elif args.gpu_cmd == "reset":
        for m in gpu.reset():
            print(m)
    elif args.gpu_cmd == "boost":
        hw()[0].set_gpu_boost(int(args.value)); print(f"ec gpu_boost -> {args.value}")
    return 0


def cmd_profile(args):
    cfg = load_config()
    if args.profile_cmd == "list":
        profs = cfg.get("profiles", {})
        if not profs:
            print(f"no profiles defined in {CONFIG_FILE}")
            return 0
        active = STATE.current("profile")
        for name in sorted(profs):
            print(("* " if name == active else "  ") + name)
        return 0
    if args.profile_cmd == "show":
        profs = cfg.get("profiles", {})
        if args.name not in profs:
            raise Err(f"no profile {args.name!r}; defined: {', '.join(sorted(profs)) or '(none)'}")
        print(f"[profiles.{args.name}]")
        for k, v in profs[args.name].items():
            print(f"  {k:<18} {json.dumps(v)}")
        return 0
    need_root()
    applied, skipped = apply_profile(args.name, cfg)
    print(f"profile {args.name}")
    for a in applied:
        print("  ok      " + a)
    for s in skipped:
        print("  skipped " + s)
    if not applied:
        print("  nothing was applied")
    return 0


def cmd_probe(args):
    here = Path(__file__).resolve().parent
    script = here / "probe.sh"
    if not script.exists():
        raise Err(f"probe.sh not found next to {__file__}")
    out = args.output or str(Path.cwd() / "aorus-probe-report.txt")
    p = subprocess.run(["bash", str(script), out])
    return p.returncode


def cmd_version(args):
    print(f"aorusctl {VERSION}")
    fans, cpu, gpu = hw()
    print(f"  fan driver     {'aorus-laptop' if fans.available else 'unavailable'}")
    print(f"  rapl domains   {', '.join(d.name for d in cpu.rapl_domains) or 'none'}")
    print(f"  intel_pstate   {rd(PSTATE / 'status', 'absent')}")
    print(f"  nvidia-smi     {gpu.smi or 'absent'}")
    print(f"  config         {CONFIG_FILE} {'(present)' if CONFIG_FILE.exists() else '(using defaults)'}")
    return 0


