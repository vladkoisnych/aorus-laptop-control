#!/usr/bin/env python3
"""
aorusctl - fan, CPU and GPU control plus live dashboard for Gigabyte AORUS /
AERO laptops running Linux. Built for the AORUS 16X (i7-14650HX + RTX 4070)
but it is written against generic interfaces and degrades gracefully.

Control paths used, in order of preference:
  fans   : aorus-laptop WMI kernel driver (/sys/devices/platform/aorus_laptop)
  cpu    : intel-rapl powercap + intel_pstate + cpufreq (all mainline sysfs)
  gpu    : nvidia-smi (power limit, locked clocks)

Nothing here pokes the embedded controller directly. Every write is clamped,
logged, recorded for rollback, and reversible with `aorusctl reset`.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

VERSION = "0.1.0"

# ----------------------------------------------------------------------------
# paths
# ----------------------------------------------------------------------------

AORUS = Path("/sys/devices/platform/aorus_laptop")
POWERCAP = Path("/sys/class/powercap")
PSTATE = Path("/sys/devices/system/cpu/intel_pstate")
CPUBASE = Path("/sys/devices/system/cpu")
HWMON = Path("/sys/class/hwmon")
PLATFORM_PROFILE = Path("/sys/firmware/acpi/platform_profile")

STATE_DIR = Path("/var/lib/aorusctl")
STATE_FILE = STATE_DIR / "state.json"
# Written when aorusctld stands down because someone picked a fan mode. The
# unit's ExecStopPost checks it so that handing the fans back to the firmware
# after a kill does not also undo a mode the user just chose.
YIELD_FLAG = Path("/run/aorusctl-daemon-yielded")
CONFIG_FILE = Path("/etc/aorusctl/config.toml")

FAN_MODES = ["normal", "silent", "gaming", "custom", "auto", "fixed"]

# Top of the EC's duty scale. The aorus-laptop driver passes the value straight
# through to the firmware without clamping, and on this family the EC's range is
# 0-229 (0xE5), not 0-255: writing 230 or more lands outside it and the fans stop
# instead of speeding up. Override with fan_duty_max in config.toml if your model
# differs.
FAN_DUTY_MAX = 229

DRY_RUN = False
VERBOSE = False


# ----------------------------------------------------------------------------
# small helpers
# ----------------------------------------------------------------------------

class Err(Exception):
    pass


def log(msg: str) -> None:
    if VERBOSE:
        sys.stderr.write(f"[aorusctl] {msg}\n")


def is_root() -> bool:
    return os.geteuid() == 0


def need_root() -> None:
    if not is_root() and not DRY_RUN:
        raise Err("this needs root - rerun with sudo (or add --dry-run to see what would happen)")


def rd(path, default=None, strip=True):
    """Read a sysfs file. Never raises."""
    try:
        v = Path(path).read_text()
        return v.strip() if strip else v
    except Exception:
        return default


def rdint(path, default=None):
    v = rd(path)
    if v is None:
        return default
    try:
        return int(v.split()[0])
    except Exception:
        return default


def wr(path, value) -> bool:
    """Write a sysfs file. Returns True on success, records nothing itself."""
    path = Path(path)
    value = str(value)
    if DRY_RUN:
        print(f"  [dry-run] write {value!r} -> {path}")
        return True
    try:
        path.write_text(value)
        log(f"wrote {value!r} -> {path}")
        return True
    except PermissionError:
        if is_root():
            raise Err(
                f"the driver refused the write to {path.name}.\n"
                f"  This is EPERM while running as root, so it is not a permissions problem.\n"
                f"  aorus-laptop returns -1 (which the kernel reports as EPERM) when the\n"
                f"  firmware's WMI method fails, so your model most likely does not\n"
                f"  implement this one.")
        raise Err(f"permission denied writing {path} (need root)")
    except OSError as e:
        raise Err(f"kernel rejected write {value!r} -> {path}: {e}")


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def run(cmd, check=False, timeout=15):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        if check:
            raise Err(f"{cmd[0]} not found")
        return None
    except subprocess.TimeoutExpired:
        if check:
            raise Err(f"{' '.join(cmd)} timed out")
        return None
    if check and p.returncode != 0:
        raise Err(f"{' '.join(cmd)} failed: {(p.stderr or p.stdout).strip()}")
    return p


# ----------------------------------------------------------------------------
# rollback state
# ----------------------------------------------------------------------------

class State:
    """Remembers the first value we ever saw for anything we change."""

    def __init__(self):
        self.data = {}
        try:
            if STATE_FILE.exists():
                self.data = json.loads(STATE_FILE.read_text())
        except Exception:
            self.data = {}

    def remember(self, key, value):
        if value is None:
            return
        self.data.setdefault("original", {})
        if key not in self.data["original"]:
            self.data["original"][key] = value
            self.save()

    def original(self, key, default=None):
        return self.data.get("original", {}).get(key, default)

    def set_current(self, key, value):
        self.data.setdefault("current", {})[key] = value
        self.save()

    def current(self, key, default=None):
        return self.data.get("current", {}).get(key, default)

    def save(self):
        if DRY_RUN:
            return
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            tmp = STATE_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(self.data, indent=2))
            tmp.replace(STATE_FILE)
        except Exception as e:
            log(f"could not save state: {e}")


STATE = State()


# ----------------------------------------------------------------------------
# fans - aorus-laptop WMI driver
# ----------------------------------------------------------------------------

class Fans:
    def __init__(self):
        self.base = AORUS
        self.hwmon = self._find_hwmon()
        # fan_pwm node was added in driver 0.2.0, which is also when
        # fan_custom_speed switched from 25-100 percent to a 0-255 byte.
        self.byte_scale = (self.base / "fan_pwm").exists()

    @property
    def available(self) -> bool:
        return (self.base / "fan_mode").exists()

    def _find_hwmon(self):
        d = self.base / "hwmon"
        if d.is_dir():
            for h in sorted(d.glob("hwmon*")):
                return h
        # fall back: any hwmon whose name looks like ours
        for h in sorted(HWMON.glob("hwmon*")):
            if rd(h / "name") in ("aorus_laptop", "aorus-laptop"):
                return h
        return None

    def why_unavailable(self) -> str:
        if not Path("/sys/bus/wmi/devices").exists():
            return "no WMI bus - kernel is missing the wmi driver"
        guid = "ABBC0F6F-8EA1-11D1-00A0-C90629100000"
        seen = [p.name.upper() for p in Path("/sys/bus/wmi/devices").glob("*")]
        if not any(guid in s for s in seen):
            return ("the Gigabyte WMI GUIDs are not exposed on this machine - "
                    "the aorus-laptop driver cannot work here")
        mods = rd("/proc/modules", "")
        if "aorus_laptop" not in mods:
            return ("aorus-laptop module is not loaded - run "
                    "`sudo modprobe aorus-laptop` (install it with install.sh)")
        return "aorus-laptop is loaded but exposed no fan_mode node"

    # ---- reads

    def mode(self):
        v = rdint(self.base / "fan_mode")
        if v is None:
            return None
        return FAN_MODES[v] if 0 <= v < len(FAN_MODES) else str(v)

    def custom_speed_pct(self):
        v = rdint(self.base / "fan_custom_speed")
        if v is None:
            return None
        return round(v * 100 / FAN_DUTY_MAX) if self.byte_scale else v

    def pwm_pct(self):
        v = rdint(self.base / "fan_pwm")
        return round(v * 100 / FAN_DUTY_MAX) if v is not None else None

    def rpms(self):
        out = {}
        if not self.hwmon:
            return out
        names = {1: "cpu", 2: "gpu", 3: "fan3", 4: "fan4"}
        for i, label in names.items():
            v = rdint(self.hwmon / f"fan{i}_input")
            if v:
                out[label] = v
        return out

    def pwms(self):
        out = {}
        if not self.hwmon:
            return out
        for i, label in {1: "cpu", 2: "gpu"}.items():
            v = rdint(self.hwmon / f"pwm{i}")
            if v is not None:
                out[label] = round(v * 100 / FAN_DUTY_MAX)
        return out

    def temps(self):
        out = {}
        if not self.hwmon:
            return out
        for i, label in {1: "cpu", 2: "gpu", 3: "board"}.items():
            v = rdint(self.hwmon / f"temp{i}_input")
            if v:
                out[label] = v / 1000.0
        return out

    def curve(self):
        """Read the 15 firmware curve points."""
        pts = []
        idx_node = self.base / "fan_curve_index"
        data_node = self.base / "fan_curve_data"
        if not idx_node.exists():
            return pts
        for i in range(15):
            try:
                wr(idx_node, i)
            except Err:
                return pts
            raw = rd(data_node, "")
            nums = [int(x) for x in raw.replace(",", " ").split() if x.lstrip("-").isdigit()]
            if len(nums) >= 2:
                temp, speed = nums[0], nums[1]   # driver prints temperature then speed
            elif len(nums) == 1:
                temp, speed = nums[0] & 0xFF, nums[0] >> 8
            else:
                continue
            if self.byte_scale:
                speed = round(speed * 100 / FAN_DUTY_MAX)
            pts.append((temp, clamp(speed, 0, 100)))
        return pts

    def charge_limit(self):
        return rdint(self.base / "charge_limit")

    def charge_mode(self):
        return rdint(self.base / "charge_mode")

    def gpu_boost(self):
        return rdint(self.base / "gpu_boost")

    def battery_cycle(self):
        return rdint(self.base / "battery_cycle")

    # ---- writes

    def set_mode(self, name):
        if name not in FAN_MODES:
            raise Err(f"unknown fan mode {name!r}; pick one of {', '.join(FAN_MODES)}")
        STATE.remember("fan_mode", self.mode() or "normal")
        wr(self.base / "fan_mode", FAN_MODES.index(name))
        STATE.set_current("fan_mode", name)

    def set_speed_pct(self, pct):
        pct = clamp(int(pct), 0, 100)
        STATE.remember("fan_custom_speed_pct", self.custom_speed_pct())
        if self.byte_scale:
            wr(self.base / "fan_custom_speed",
               clamp(round(pct * FAN_DUTY_MAX / 100), 0, FAN_DUTY_MAX))
        else:
            # old driver: 25-100 and divisible by 5
            val = clamp(int(round(pct / 5) * 5), 25, 100)
            wr(self.base / "fan_custom_speed", val)
        STATE.set_current("fan_custom_speed_pct", pct)

    def set_curve(self, points):
        """points: list of (temp_c, speed_pct), at most 15, non-decreasing."""
        if not points:
            raise Err("empty curve")
        if len(points) > 15:
            raise Err("the firmware curve holds at most 15 points")
        pts = sorted((clamp(int(t), 0, 100), clamp(int(s), 0, 100)) for t, s in points)
        last_t = last_s = -1
        for t, s in pts:
            if t < last_t or s < last_s:
                raise Err("curve points must be non-decreasing in both temperature and speed")
            last_t, last_s = t, s
        # pad to 15 by repeating the last point
        while len(pts) < 15:
            pts.append(pts[-1])
        # Reading the curve moves the firmware's index cursor, so only do it
        # the first time, when there is actually an original worth keeping.
        if STATE.original("fan_curve") is None:
            STATE.remember("fan_curve", self.curve())
        for i, (t, s) in enumerate(pts):
            wr(self.base / "fan_curve_index", i)
            wr(self.base / "fan_curve_data",
               (clamp(round(s * FAN_DUTY_MAX / 100), 0, FAN_DUTY_MAX) << 8) | t)
        STATE.set_current("fan_curve", pts)

    def set_charge_limit(self, pct):
        pct = clamp(int(pct), 60, 100)
        STATE.remember("charge_mode", self.charge_mode())
        STATE.remember("charge_limit", self.charge_limit())
        wr(self.base / "charge_mode", 1)
        wr(self.base / "charge_limit", pct)

    def set_gpu_boost(self, v):
        STATE.remember("gpu_boost", self.gpu_boost())
        wr(self.base / "gpu_boost", clamp(int(v), 0, 2))


# ----------------------------------------------------------------------------
# cpu - powercap / intel_pstate / cpufreq
# ----------------------------------------------------------------------------

class Cpu:
    def __init__(self):
        self.rapl_domains = self._find_rapl()
        self.coretemp = self._find_coretemp()
        self._last_energy = None
        self._last_time = None
        self.energy_dom, self.power_note = self._find_energy_source()

    def _find_energy_source(self):
        """Pick a package domain with a readable energy counter.

        Two things bite here. The MMIO twin usually has no energy_uj at all, and
        since the RAPL side-channel mitigation (CVE-2020-8694) energy_uj is mode
        0400, so an unprivileged read returns nothing rather than an error.
        """
        cands = [d for d in self.rapl_domains if (d / "energy_uj").exists()]
        # MSR domain before the MMIO one
        cands.sort(key=lambda d: ("mmio" in d.name, d.name))
        for d in cands:
            if rd(d / "energy_uj") is not None:
                return d, None
        if cands:
            if not is_root():
                return None, "energy_uj is root-readable only, so package watts needs sudo"
            return None, "energy_uj exists but could not be read"
        return None, "this firmware exposes no RAPL energy counter"

    def _find_rapl(self):
        """Every writable package domain (intel-rapl and its mmio twin)."""
        out = []
        for d in sorted(POWERCAP.glob("intel-rapl*:0")):
            name = rd(d / "name", "")
            if name.startswith("package"):
                out.append(d)
        return out

    def _find_coretemp(self):
        for h in sorted(HWMON.glob("hwmon*")):
            if rd(h / "name") == "coretemp":
                return h
        return None

    # ---- reads

    def constraints(self):
        """[{domain, index, name, limit_w, max_w, window_us}]"""
        out = []
        for d in self.rapl_domains:
            for i in range(4):
                lp = d / f"constraint_{i}_power_limit_uw"
                if not lp.exists():
                    continue
                out.append({
                    "domain": d.name,
                    "index": i,
                    "name": rd(d / f"constraint_{i}_name", f"constraint_{i}"),
                    "limit_w": (rdint(lp) or 0) / 1_000_000,
                    "max_w": (rdint(d / f"constraint_{i}_max_power_uw") or 0) / 1_000_000,
                    "window_us": rdint(d / f"constraint_{i}_time_window_us"),
                })
        return out

    def package_power_w(self):
        """Average package watts since the previous call."""
        if not self.energy_dom:
            return None
        e = rdint(self.energy_dom / "energy_uj")
        t = time.monotonic()
        if e is None:
            return None
        prev_e, prev_t = self._last_energy, self._last_time
        self._last_energy, self._last_time = e, t
        if prev_e is None or t <= prev_t:
            return None
        de = e - prev_e
        if de < 0:  # counter wrapped
            rng = self._energy_range()
            de += rng
        return de / 1_000_000 / (t - prev_t)

    def _energy_range(self):
        return rdint(self.energy_dom / "max_energy_range_uj") or 0

    def temps(self):
        out = {"package": None, "cores": []}
        if not self.coretemp:
            return out
        for f in sorted(self.coretemp.glob("temp*_label")):
            label = rd(f, "")
            val = rdint(str(f).replace("_label", "_input"))
            if val is None:
                continue
            c = val / 1000.0
            if "Package" in label:
                out["package"] = c
            elif label.startswith("Core"):
                out["cores"].append((label, c))
        return out

    def freqs_mhz(self):
        out = []
        for d in sorted(CPUBASE.glob("cpu[0-9]*/cpufreq"), key=lambda p: int(p.parent.name[3:])):
            v = rdint(d / "scaling_cur_freq") or rdint(d / "cpuinfo_cur_freq")
            if v:
                out.append(v / 1000)
        return out

    def governor(self):
        return rd(CPUBASE / "cpu0/cpufreq/scaling_governor")

    def governors(self):
        return (rd(CPUBASE / "cpu0/cpufreq/scaling_available_governors") or "").split()

    def epp(self):
        return rd(CPUBASE / "cpu0/cpufreq/energy_performance_preference")

    def epps(self):
        return (rd(CPUBASE / "cpu0/cpufreq/energy_performance_available_preferences") or "").split()

    def max_perf_pct(self):
        return rdint(PSTATE / "max_perf_pct")

    def min_perf_pct(self):
        return rdint(PSTATE / "min_perf_pct")

    def turbo(self):
        v = rdint(PSTATE / "no_turbo")
        return None if v is None else (v == 0)

    def platform_profile(self):
        return rd(PLATFORM_PROFILE)

    def platform_profiles(self):
        return (rd("/sys/firmware/acpi/platform_profile_choices") or "").split()

    # ---- writes

    def _set_constraint(self, want_name, watts):
        """Set a RAPL constraint by name across every package domain."""
        done, errors = [], []
        for d in self.rapl_domains:
            for i in range(4):
                lp = d / f"constraint_{i}_power_limit_uw"
                if not lp.exists():
                    continue
                if rd(d / f"constraint_{i}_name", "") != want_name:
                    continue
                cur = rdint(lp)
                STATE.remember(f"rapl|{d.name}|{i}", cur)
                cap = rdint(d / f"constraint_{i}_max_power_uw") or 0
                uw = int(watts * 1_000_000)
                note = ""
                # A max of 0 means the firmware did not publish one. Do not treat
                # that as a ceiling of zero; attempt the write and let the kernel
                # reject it if it is out of range.
                if cap > 0 and uw > cap:
                    uw = cap
                    note = f"  (firmware caps this domain at {cap/1_000_000:.0f} W)"
                try:
                    wr(lp, uw)
                    done.append(f"{d.name}/{want_name} -> {uw/1_000_000:.1f} W{note}")
                except Err as e:
                    errors.append(f"{d.name}/{want_name}: {e}")
        if not done:
            hint = ("; ".join(errors) if errors else
                    f"no {want_name} constraint found - your firmware may lock RAPL")
            raise Err(f"could not set {want_name}: {hint}")
        return done

    def set_pl1(self, watts):
        watts = clamp(float(watts), 5, 200)
        return self._set_constraint("long_term", watts)

    def set_pl2(self, watts):
        watts = clamp(float(watts), 5, 250)
        return self._set_constraint("short_term", watts)

    def set_max_perf_pct(self, pct):
        pct = clamp(int(pct), 10, 100)
        if not (PSTATE / "max_perf_pct").exists():
            raise Err("intel_pstate is not active on this kernel")
        STATE.remember("max_perf_pct", self.max_perf_pct())
        wr(PSTATE / "max_perf_pct", pct)

    def set_turbo(self, on: bool):
        if not (PSTATE / "no_turbo").exists():
            raise Err("intel_pstate no_turbo not available")
        STATE.remember("no_turbo", rdint(PSTATE / "no_turbo"))
        wr(PSTATE / "no_turbo", 0 if on else 1)

    def set_governor(self, gov):
        avail = self.governors()
        if avail and gov not in avail:
            raise Err(f"governor {gov!r} not available; have: {', '.join(avail)}")
        STATE.remember("governor", self.governor())
        n = 0
        for d in sorted(CPUBASE.glob("cpu[0-9]*/cpufreq")):
            try:
                wr(d / "scaling_governor", gov)
                n += 1
            except Err:
                pass
        if n == 0:
            raise Err("no cpufreq policy accepted the governor")
        return n

    def set_epp(self, pref):
        avail = self.epps()
        if avail and pref not in avail:
            raise Err(f"EPP {pref!r} not available; have: {', '.join(avail)}")
        STATE.remember("epp", self.epp())
        n = 0
        for d in sorted(CPUBASE.glob("cpu[0-9]*/cpufreq")):
            p = d / "energy_performance_preference"
            if p.exists():
                try:
                    wr(p, pref)
                    n += 1
                except Err:
                    pass
        if n == 0:
            raise Err("no cpufreq policy accepted the EPP value")
        return n

    def set_platform_profile(self, name):
        avail = self.platform_profiles()
        if not avail:
            raise Err("this firmware exposes no platform_profile")
        if name not in avail:
            raise Err(f"profile {name!r} not available; have: {', '.join(avail)}")
        STATE.remember("platform_profile", self.platform_profile())
        wr(PLATFORM_PROFILE, name)


# ----------------------------------------------------------------------------
# gpu - nvidia-smi
# ----------------------------------------------------------------------------

GPU_FIELDS = [
    "name", "temperature.gpu", "utilization.gpu", "utilization.memory",
    "power.draw", "power.limit", "power.default_limit",
    "power.min_limit", "power.max_limit",
    "clocks.sm", "clocks.mem", "memory.used", "memory.total", "fan.speed",
]


class Gpu:
    def __init__(self):
        self.smi = shutil.which("nvidia-smi")

    @property
    def available(self):
        return self.smi is not None

    def query(self):
        if not self.smi:
            return None
        p = run([self.smi, f"--query-gpu={','.join(GPU_FIELDS)}",
                 "--format=csv,noheader,nounits"])
        if not p or p.returncode != 0 or not p.stdout.strip():
            return None
        parts = [x.strip() for x in p.stdout.strip().splitlines()[0].split(",")]
        out = {}
        for k, v in zip(GPU_FIELDS, parts):
            if v in ("[N/A]", "[Not Supported]", "N/A", ""):
                out[k] = None
                continue
            try:
                out[k] = float(v) if k != "name" else v
            except ValueError:
                out[k] = v
        return out

    def power_detail(self):
        """Parse `nvidia-smi -q -d POWER`. Some laptop vBIOSes report the
        enforced limit only here and leave the CSV query as N/A."""
        if not self.smi:
            return {}
        p = run([self.smi, "-q", "-d", "POWER"])
        if not p or p.returncode != 0:
            return {}
        out = {}
        for line in p.stdout.splitlines():
            if ":" not in line:
                continue
            k, _, v = line.partition(":")
            k, v = k.strip(), v.strip()
            if not k or v in ("N/A", "[N/A]", "[Not Supported]"):
                continue
            try:
                out[k] = float(v.split()[0])
            except (ValueError, IndexError):
                out[k] = v
        return out

    def enforced_limit_w(self):
        """Best available reading of the limit actually in force."""
        q = self.query() or {}
        if q.get("power.limit") is not None:
            return q["power.limit"]
        d = self.power_detail()
        for k in ("Current Power Limit", "Requested Power Limit", "Power Limit"):
            v = d.get(k)
            if isinstance(v, float):
                return v
        return None

    def powerd_active(self):
        """nvidia-powerd drives Dynamic Boost and rewrites the power limit
        continuously, so anything set with -pl is overwritten within seconds."""
        p = run(["systemctl", "is-active", "nvidia-powerd"])
        return bool(p and p.stdout.strip() == "active")

    def powerd_state(self):
        """'active', 'disabled' (installed but not running), or 'absent'.

        On Ada laptops Dynamic Boost is what lifts the GPU above its base TGP.
        It is nvidia-powerd that does the lifting, so with the service off the
        GPU sits at power.default_limit no matter what anything else asks for.
        """
        if self.powerd_active():
            return "active"
        p = run(["systemctl", "is-enabled", "nvidia-powerd"])
        out = (p.stdout + p.stderr).strip() if p else ""
        if not out or "not-found" in out or "No such file" in out:
            return "absent"
        return "disabled"

    def persistence_on(self):
        p = run([self.smi, "--query-gpu=persistence_mode", "--format=csv,noheader"])
        return bool(p and p.returncode == 0 and p.stdout.strip().lower().startswith("enabled"))

    def set_power_limit(self, watts):
        if not self.smi:
            raise Err("nvidia-smi not found")
        need_root()
        q = self.query() or {}
        lo = q.get("power.min_limit") or 1
        hi = q.get("power.max_limit") or 200
        w = clamp(float(watts), lo, hi)
        STATE.remember("gpu_power_limit", q.get("power.default_limit") or q.get("power.limit"))
        if DRY_RUN:
            print(f"  [dry-run] nvidia-smi -pm 1; nvidia-smi -pl {w:.0f}")
            return f"would set {w:.0f} W"

        # Without persistence mode the driver tears down GPU state whenever the
        # last client exits, and the limit goes back to default with it. This is
        # the usual reason a limit appears to take and then quietly reverts.
        turned_on_persistence = False
        if not self.persistence_on():
            r = run([self.smi, "-pm", "1"])
            turned_on_persistence = bool(r and r.returncode == 0 and self.persistence_on())

        p = run([self.smi, "-pl", f"{w:.0f}"])
        if p is None or p.returncode != 0:
            msg = (p.stderr or p.stdout).strip() if p else "no output"
            raise Err(f"nvidia-smi -pl failed: {msg}\n"
                      f"  Many laptop vBIOSes lock the power limit. Try "
                      f"`aorusctl gpu clocks` or the EC's gpu_boost instead.")

        # Trust nothing: read it back.
        time.sleep(1.2)
        got = self.enforced_limit_w()
        if got is not None and abs(got - w) > 1.5:
            hint = ""
            if self.powerd_active():
                hint = ("\n  nvidia-powerd is running, which is what you want. It manages"
                        " Dynamic Boost and rewrites"
                        "\n  the power limit continuously, moving budget to the GPU when the"
                        " CPU is not using its share,"
                        "\n  so a fixed limit set here is overwritten within a second or two."
                        " The limit is meant to move."
                        "\n"
                        "\n  To cap the GPU anyway, lock its clocks instead:"
                        "\n    sudo aorusctl gpu clocks 210,1800"
                        "\n  Or stop nvidia-powerd first (`sudo systemctl stop nvidia-powerd`),"
                        " which gives up Dynamic Boost"
                        "\n  and leaves the GPU at its base TGP."
                        "\n"
                        "\n  `aorusctl gpu boost` steers the EC instead, but not every model"
                        " implements that WMI method;"
                        "\n  if it returns EPERM under sudo, yours does not.")
            else:
                hint = ("\n  Nothing is fighting you. On laptop GPUs the power limit belongs to"
                        " the vBIOS and platform firmware,"
                        "\n  not the driver, so nvidia-smi accepts -pl, reports success, and the"
                        " enforced limit never moves.")
                if q.get("power.limit") is None:
                    hint += ("\n  This GPU reports no enforced limit at all (power.limit is"
                             " N/A), which is the usual sign of that.")
                st = self.powerd_state()
                if st == "disabled":
                    hint += (f"\n\n  What you probably want instead: nvidia-powerd is installed"
                             f" here but not running.\n"
                             f"  It is what implements Dynamic Boost, so with it off the GPU"
                             f" stays at its {q.get('power.default_limit') or 'base'} W base TGP"
                             f" and never reaches the"
                             f" {q.get('power.max_limit') or 'higher'} W ceiling.\n"
                             f"    sudo systemctl enable --now nvidia-powerd\n"
                             f"  It then raises the limit itself when CPU headroom allows, which"
                             f" is the only route to the full budget.")
                elif st == "absent":
                    hint += ("\n\n  nvidia-powerd is not installed, so Dynamic Boost is"
                             " unavailable and the GPU is capped at its base TGP.")
                hint += ("\n\n  To cap the GPU lower rather than higher, clocks do work:"
                         "\n    sudo aorusctl gpu clocks 210,1800")
            raise Err(f"asked for {w:.0f} W but the GPU is still at {got:.0f} W.{hint}")

        STATE.set_current("gpu_power_limit", w)
        msg = f"GPU power limit -> {w:.0f} W (range {lo:.0f}-{hi:.0f} W)"
        if got is None:
            msg += "\n  Could not read the limit back, so this is unconfirmed."
        if turned_on_persistence:
            STATE.remember("gpu_persistence", 0)
            msg += ("\n  Persistence mode was off, so the limit would have reverted as soon"
                    " as the GPU went idle. It is on now."
                    "\n  That keeps the dGPU initialised and costs battery on a laptop."
                    " `sudo nvidia-smi -pm 0` turns it off again,"
                    "\n  and so does `aorusctl reset`.")
        return msg

    def set_clocks(self, lo, hi):
        if not self.smi:
            raise Err("nvidia-smi not found")
        need_root()
        if DRY_RUN:
            print(f"  [dry-run] nvidia-smi -lgc {int(lo)},{int(hi)}")
            return "would lock clocks"
        p = run([self.smi, "-lgc", f"{int(lo)},{int(hi)}"])
        if p is None or p.returncode != 0:
            msg = (p.stderr or p.stdout).strip() if p else "no output"
            raise Err(f"nvidia-smi -lgc failed: {msg}")
        STATE.set_current("gpu_clocks", [int(lo), int(hi)])
        return f"GPU clocks locked to {int(lo)}-{int(hi)} MHz"

    def unlock_clocks(self):
        if not self.smi:
            raise Err("nvidia-smi not found")
        need_root()
        if DRY_RUN:
            print("  [dry-run] nvidia-smi -rgc")
            return "would unlock clocks"
        p = run([self.smi, "-rgc"])
        if p is None or p.returncode != 0:
            msg = (p.stderr or p.stdout).strip() if p else "no output"
            raise Err(f"nvidia-smi -rgc failed: {msg}")
        STATE.set_current("gpu_clocks", None)
        return "GPU clocks unlocked"

    def reset(self):
        if not self.smi:
            return []
        need_root()
        msgs = []
        if DRY_RUN:
            return ["  [dry-run] nvidia-smi -rgc ; nvidia-smi -pl <default>"]
        p = run([self.smi, "-rgc"])
        msgs.append("GPU clocks unlocked" if p and p.returncode == 0 else "GPU clock reset skipped")
        default = STATE.original("gpu_power_limit")
        if default is None:
            q = self.query() or {}
            default = q.get("power.default_limit")
        if default:
            p = run([self.smi, "-pl", f"{float(default):.0f}"])
            if p and p.returncode == 0:
                msgs.append(f"GPU power limit restored to {float(default):.0f} W")
        return msgs


