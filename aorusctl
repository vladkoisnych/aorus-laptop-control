def apply_config_globals(cfg):
    global FAN_DUTY_MAX
    v = (cfg.get("fans") or {}).get("duty_max")
    if isinstance(v, int) and 100 <= v <= 255:
        FAN_DUTY_MAX = v


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if CONFIG_FILE.exists():
        try:
            import tomllib
            user = tomllib.loads(CONFIG_FILE.read_text())
        except Exception as e:
            raise Err(f"could not parse {CONFIG_FILE}: {e}")
        for k, v in user.items():
            if isinstance(v, dict) and isinstance(cfg.get(k), dict):
                cfg[k].update(v)
            else:
                cfg[k] = v
    return cfg


def apply_profile(name, cfg=None):
    cfg = cfg or load_config()
    profs = cfg.get("profiles", {})
    if name not in profs:
        raise Err(f"no profile {name!r}; defined: {', '.join(sorted(profs)) or '(none)'}")
    p = profs[name]
    fans, cpu, gpu = hw()
    applied, skipped = [], []

    unknown = sorted(set(p) - PROFILE_KEYS)
    if unknown:
        skipped.append(f"unknown setting{'s' if len(unknown) > 1 else ''}: "
                       f"{', '.join(unknown)}")

    def attempt(label, fn):
        try:
            fn()
            applied.append(label)
        except Err as e:
            # The full explanations are long by design. In a profile summary one
            # line per skip is enough; run the command directly for the rest.
            first = str(e).strip().splitlines()[0]
            skipped.append(f"{label}: {first}")

    if "platform_profile" in p:
        attempt(f"platform_profile={p['platform_profile']}",
                lambda: cpu.set_platform_profile(p["platform_profile"]))
    if "cpu_pl1" in p:
        attempt(f"PL1={p['cpu_pl1']}W", lambda: cpu.set_pl1(p["cpu_pl1"]))
    if "cpu_pl2" in p:
        attempt(f"PL2={p['cpu_pl2']}W", lambda: cpu.set_pl2(p["cpu_pl2"]))
    if "max_perf_pct" in p:
        attempt(f"max_perf={p['max_perf_pct']}%", lambda: cpu.set_max_perf_pct(p["max_perf_pct"]))
    if "turbo" in p:
        attempt(f"turbo={'on' if p['turbo'] else 'off'}", lambda: cpu.set_turbo(bool(p["turbo"])))
    if "governor" in p:
        attempt(f"governor={p['governor']}", lambda: cpu.set_governor(p["governor"]))
    if "epp" in p:
        attempt(f"epp={p['epp']}", lambda: cpu.set_epp(p["epp"]))
    if "gpu_power_limit" in p:
        attempt(f"gpu_pl={p['gpu_power_limit']}W", lambda: gpu.set_power_limit(p["gpu_power_limit"]))
    if "gpu_clocks" in p:
        v = p["gpu_clocks"]
        if v in ("reset", "auto", []) :
            attempt("gpu clocks unlocked", gpu.unlock_clocks)
        else:
            lo, hi = v
            attempt(f"gpu_clocks={lo}-{hi}", lambda: gpu.set_clocks(lo, hi))
    if "gpu_boost" in p:
        attempt(f"gpu_boost={p['gpu_boost']}", lambda: fans.set_gpu_boost(p["gpu_boost"]))
    if "fan_curve" in p:
        attempt("fan curve", lambda: fans.set_curve([tuple(x) for x in p["fan_curve"]]))
    if "fan_speed" in p:
        attempt(f"fan speed={p['fan_speed']}%", lambda: fans.set_speed_pct(p["fan_speed"]))
    if "fan_mode" in p:
        attempt(f"fan mode={p['fan_mode']}", lambda: fans.set_mode(p["fan_mode"]))
    if "charge_limit" in p:
        attempt(f"charge limit={p['charge_limit']}%", lambda: fans.set_charge_limit(p["charge_limit"]))

    STATE.set_current("profile", name)
    return applied, skipped


