def cmd_web(args):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    cfg = load_config()
    model = rd("/sys/class/dmi/id/product_name", "laptop")
    snapshot()

    class H(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *a):
            if VERBOSE:
                BaseHTTPRequestHandler.log_message(self, *a)

        def _send(self, code, body, ctype):
            if isinstance(body, str):
                body = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _local_only(self):
            host = self.client_address[0]
            if host not in ("127.0.0.1", "::1", "localhost"):
                self._send(403, '{"ok":false,"message":"controls are localhost-only"}',
                           "application/json")
                return False
            return True

        def do_GET(self):
            if self.path.startswith("/api/status"):
                s = snapshot()
                s["model"] = model
                s["root"] = is_root()
                s["fan_modes"] = FAN_MODES
                s["profiles"] = sorted(cfg.get("profiles", {}))
                s["active_profile"] = STATE.current("profile")
                self._send(200, json.dumps(s, default=str), "application/json")
            elif self.path in ("/", "/index.html"):
                self._send(200, WEB_PAGE, "text/html; charset=utf-8")
            else:
                self._send(404, "not found", "text/plain")

        def do_POST(self):
            if not self.path.startswith("/api/action"):
                return self._send(404, "not found", "text/plain")
            if not self._local_only():
                return
            n = int(self.headers.get("Content-Length") or 0)
            try:
                req = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                return self._send(400, '{"ok":false,"message":"bad json"}', "application/json")
            ok, msg = True, ""
            a, v = req.get("action"), req.get("value")
            fans, cpu, gpu = hw()
            try:
                if not is_root():
                    raise Err("started without root - restart with sudo to change anything")
                if a == "fan_mode":
                    note = yield_daemon("a fan mode was picked in the dashboard")
                    fans.set_mode(v)
                    msg = f"fan mode {v}" + (f"  ({note})" if note else "")
                elif a == "fan_speed":
                    note = yield_daemon("a fixed duty was set in the dashboard")
                    fans.set_speed_pct(v)
                    if fans.mode() not in ("fixed", "auto"):
                        fans.set_mode("fixed")
                    msg = f"fan fixed at {v}%" + (f"  ({note})" if note else "")
                elif a == "pl1":
                    msg = "; ".join(cpu.set_pl1(float(v)))
                elif a == "pl2":
                    msg = "; ".join(cpu.set_pl2(float(v)))
                elif a == "max_perf_pct":
                    cpu.set_max_perf_pct(int(v)); msg = f"max_perf_pct {v}"
                elif a == "turbo":
                    cpu.set_turbo(str(v) == "1"); msg = f"turbo {'on' if str(v) == '1' else 'off'}"
                elif a == "gpu_power_limit":
                    msg = gpu.set_power_limit(float(v))
                elif a == "gpu_boost":
                    fans.set_gpu_boost(int(v)); msg = f"EC gpu_boost {v}"
                elif a == "gpu_reset":
                    msg = "; ".join(gpu.reset()) or "nothing to reset"
                elif a == "profile":
                    applied, skipped = apply_profile(v, cfg)
                    msg = f"profile {v}: " + (", ".join(applied) or "nothing applied")
                    if skipped:
                        msg += "  |  skipped: " + "; ".join(skipped)
                elif a == "reset":
                    import contextlib as _c, io as _io

                    class _A:
                        pass
                    _b = _io.StringIO()
                    with _c.redirect_stdout(_b):
                        cmd_reset(_A())
                    msg = "reverted: " + "; ".join(
                        x.strip() for x in _b.getvalue().splitlines()[1:] if x.strip())
                else:
                    raise Err(f"unknown action {a!r}")
            except Err as e:
                ok, msg = False, str(e)
            except Exception as e:
                ok, msg = False, f"{type(e).__name__}: {e}"
            self._send(200, json.dumps({"ok": ok, "message": msg}), "application/json")

    srv = ThreadingHTTPServer((args.bind, args.port), H)
    print(f"aorusctl dashboard on http://{args.bind}:{args.port}"
          + ("" if is_root() else "   (read-only: not running as root)"))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
    return 0


