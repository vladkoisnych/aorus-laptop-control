FANS = None
CPU = None
GPU = None


def hw():
    global FANS, CPU, GPU
    if FANS is None:
        FANS, CPU, GPU = Fans(), Cpu(), Gpu()
    return FANS, CPU, GPU


def daemon_active():
    p = run(["systemctl", "is-active", "aorusctld"])
    return bool(p and p.stdout.strip() == "active")


def yield_daemon(reason="a fan mode was set by hand"):
    """Stop aorusctld so an explicit choice sticks. Returns a note, or None.

    Choosing a fan mode should hold until it is changed again, so anything that
    sets one takes the fans off the daemon rather than quietly losing to it a
    couple of seconds later.
    """
    if not daemon_active():
        return None
    if DRY_RUN:
        return "  [dry-run] would stop aorusctld"
    run(["systemctl", "stop", "aorusctld"])
    time.sleep(0.4)
    return f"stopped aorusctld ({reason}); `sudo systemctl start aorusctld` puts it back"


def snapshot():
    fans, cpu, gpu = hw()
    ct = cpu.temps()
    freqs = cpu.freqs_mhz()
    ftemps = fans.temps()
    g = gpu.query() if gpu.available else None
    return {
        "time": time.time(),
        "fan": {
            "available": fans.available,
            "mode": fans.mode(),
            "custom_speed_pct": fans.custom_speed_pct(),
            "pwm_pct": fans.pwm_pct(),
            "rpm": fans.rpms(),
            "duty": fans.pwms(),
            "ec_temps": ftemps,
            "charge_limit": fans.charge_limit(),
            "charge_mode": fans.charge_mode(),
            "gpu_boost": fans.gpu_boost(),
            "battery_cycle": fans.battery_cycle(),
            "daemon": daemon_active(),
        },
        "cpu": {
            "package_c": ct["package"] if ct["package"] is not None else ftemps.get("cpu"),
            "cores_c": ct["cores"],
            "power_w": cpu.package_power_w(),
            "power_note": cpu.power_note,
            "freq_mhz_avg": round(sum(freqs) / len(freqs)) if freqs else None,
            "freq_mhz_max": round(max(freqs)) if freqs else None,
            "freqs": freqs,
            "governor": cpu.governor(),
            "epp": cpu.epp(),
            "max_perf_pct": cpu.max_perf_pct(),
            "min_perf_pct": cpu.min_perf_pct(),
            "turbo": cpu.turbo(),
            "constraints": cpu.constraints(),
            "platform_profile": cpu.platform_profile(),
        },
        "gpu": ({
            "available": True,
            "name": g.get("name"),
            "temp_c": g.get("temperature.gpu"),
            "util_pct": g.get("utilization.gpu"),
            "mem_util_pct": g.get("utilization.memory"),
            "power_w": g.get("power.draw"),
            "power_limit_w": g.get("power.limit") or g.get("power.default_limit"),
            "power_limit_reported": g.get("power.limit") is not None,
            "power_default_w": g.get("power.default_limit"),
            "power_min_w": g.get("power.min_limit"),
            "power_max_w": g.get("power.max_limit"),
            "clock_sm_mhz": g.get("clocks.sm"),
            "clock_mem_mhz": g.get("clocks.mem"),
            "mem_used_mb": g.get("memory.used"),
            "mem_total_mb": g.get("memory.total"),
            "fan_pct": g.get("fan.speed"),
            "powerd": gpu.powerd_active(),
            "powerd_state": gpu.powerd_state(),
            "persistence": gpu.persistence_on(),
        } if g else {"available": gpu.available, "name": None}),
    }


def fmt(v, unit="", nd=0):
    if v is None:
        return "  --"
    if isinstance(v, float):
        return f"{v:.{nd}f}{unit}"
    return f"{v}{unit}"


def cmd_status(args):
    snapshot()          # prime the RAPL energy counter
    time.sleep(0.35)
    s = snapshot()      # second read, so package watts is a real average
    if args.json:
        print(json.dumps(s, indent=2, default=str))
        return 0

    f, c, g = s["fan"], s["cpu"], s["gpu"]
    print(f"aorusctl {VERSION}   {rd('/sys/class/dmi/id/product_name', 'unknown laptop')}")
    print()
    print("CPU")
    pw = fmt(c["power_w"], " W", 1)
    if c["power_w"] is None and c.get("power_note"):
        pw = f"--  ({c['power_note']})"
    print(f"  package        {fmt(c['package_c'], ' C', 1):>12}   power {pw:>10}")
    print(f"  freq           {fmt(c['freq_mhz_avg'], ' MHz'):>12}   peak  {fmt(c['freq_mhz_max'], ' MHz'):>10}")
    print(f"  governor       {str(c['governor']):>12}   epp   {str(c['epp']):>10}")
    print(f"  perf window    {fmt(c['min_perf_pct'], '%')}-{fmt(c['max_perf_pct'], '%')}"
          f"        turbo {('on' if c['turbo'] else 'off') if c['turbo'] is not None else '--'}")
    for k in c["constraints"]:
        if not k["max_w"]:
            cap = "max not published"
        elif k["limit_w"] > k["max_w"]:
            cap = f"max {k['max_w']:.0f} W, so this domain is not the binding one"
        else:
            cap = f"max {k['max_w']:.0f} W"
        print(f"  rapl {k['domain']:<20} {k['name']:<12} {k['limit_w']:6.1f} W  ({cap})")
    eff = [k["limit_w"] for k in c["constraints"]
           if k["name"] == "long_term" and k["limit_w"] > 0]
    if len(eff) > 1 and min(eff) != max(eff):
        print(f"  effective PL1    {min(eff):.0f} W   (the lower of the MSR and MMIO limits wins)")
    if c["platform_profile"]:
        print(f"  platform profile  {c['platform_profile']}")
    print()
    print("GPU")
    if g.get("name"):
        print(f"  {g['name']}")
        lim = fmt(g["power_limit_w"], " W", 0)
        if not g.get("power_limit_reported") and g["power_limit_w"]:
            lim += " (default; vBIOS does not report the enforced value)"
        print(f"  temp           {fmt(g['temp_c'], ' C'):>12}   power {fmt(g['power_w'], ' W', 1):>10}"
              f"  limit {lim}")
        print(f"  util           {fmt(g['util_pct'], ' %'):>12}   sm    {fmt(g['clock_sm_mhz'], ' MHz'):>10}"
              f"  mem {fmt(g['clock_mem_mhz'], ' MHz')}")
        print(f"  vram           {fmt(g['mem_used_mb'], ' MB'):>12} / {fmt(g['mem_total_mb'], ' MB')}")
        if g["power_min_w"]:
            print(f"  limit range    {fmt(g['power_min_w'], '')}-{fmt(g['power_max_w'], ' W')}"
                  f"  (default {fmt(g['power_default_w'], ' W')})")
        st = g.get("powerd_state")
        if st == "active":
            print("  nvidia-powerd  running, so Dynamic Boost is managing the limit")
        elif st == "disabled":
            print(f"  nvidia-powerd  installed but not running, so Dynamic Boost is off and "
                  f"the GPU is stuck at {fmt(g['power_default_w'], ' W')}")
            print("                 sudo systemctl enable --now nvidia-powerd")
        elif st == "absent":
            print("  nvidia-powerd  not installed, so Dynamic Boost is unavailable")
        if g.get("persistence") is False:
            print("  persistence    off, so limits reset when the last GPU client exits")
    else:
        print("  nvidia-smi unavailable")
    print()
    print("FANS")
    if f["available"]:
        print(f"  mode           {str(f['mode']):>12}   duty  {fmt(f['pwm_pct'], ' %'):>10}"
              f"  custom {fmt(f['custom_speed_pct'], ' %')}")
        if f["rpm"]:
            print("  rpm            " + "   ".join(f"{k}:{v}" for k, v in f["rpm"].items()))
        if f["duty"]:
            print("  per-fan duty   " + "   ".join(f"{k}:{v}%" for k, v in f["duty"].items()))
        if f["ec_temps"]:
            print("  ec temps       " + "   ".join(f"{k}:{v:.0f}C" for k, v in f["ec_temps"].items()))
        extra = []
        if f["charge_limit"]:
            extra.append(f"charge limit {f['charge_limit']}% (mode {f['charge_mode']})")
        if f["battery_cycle"]:
            extra.append(f"battery cycles {f['battery_cycle']}")
        if f["gpu_boost"] is not None:
            extra.append(f"gpu_boost {f['gpu_boost']}")
        if extra:
            print("  " + "   ".join(extra))
        if f.get("daemon"):
            print("  aorusctld is running, so it owns the fans and will reassert fixed mode")
            print("  within a couple of seconds of any change. `sudo systemctl stop "
                  "aorusctld` to take over.")
    else:
        print("  unavailable: " + hw()[0].why_unavailable())
    return 0


