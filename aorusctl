def cmd_mon(args):
    import curses

    hist = {"cpu_t": [], "gpu_t": [], "cpu_w": [], "gpu_w": [], "fan": []}
    MAXH = 240

    def push(k, v):
        hist[k].append(v if v is not None else 0)
        if len(hist[k]) > MAXH:
            hist[k].pop(0)

    BLOCKS = " ▁▂▃▄▅▆▇█"

    def spark(vals, width, vmax=None):
        if not vals:
            return " " * width
        v = vals[-width:]
        top = vmax or max(max(v), 1)
        return "".join(BLOCKS[clamp(int(x / top * 8), 0, 8)] for x in v).rjust(width)

    def bar(win, y, x, w, frac, label, color):
        frac = clamp(frac if frac is not None else 0, 0, 1)
        filled = int(frac * w)
        win.addstr(y, x, label)
        win.addstr(y, x + 16, "[")
        win.addstr(y, x + 17, "#" * filled, curses.color_pair(color) | curses.A_BOLD)
        win.addstr(y, x + 17 + filled, "." * (w - filled))
        win.addstr(y, x + 17 + w, "]")

    def draw(stdscr):
        curses.curs_set(0)
        stdscr.nodelay(True)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_YELLOW, -1)
        curses.init_pair(3, curses.COLOR_RED, -1)
        curses.init_pair(4, curses.COLOR_CYAN, -1)
        curses.init_pair(5, curses.COLOR_MAGENTA, -1)

        snapshot()  # prime the RAPL counter
        model = rd("/sys/class/dmi/id/product_name", "laptop")

        while True:
            s = snapshot()
            c, g, f = s["cpu"], s["gpu"], s["fan"]
            push("cpu_t", c["package_c"]); push("gpu_t", g.get("temp_c"))
            push("cpu_w", c["power_w"]); push("gpu_w", g.get("power_w"))
            push("fan", (f["rpm"] or {}).get("cpu"))

            stdscr.erase()
            h, w = stdscr.getmaxyx()
            sw = max(10, min(w - 34, 60))

            def tcolor(t):
                if t is None:
                    return 1
                return 3 if t >= 88 else (2 if t >= 75 else 1)

            y = 0
            stdscr.addstr(y, 0, f" aorusctl {VERSION}  {model} ", curses.A_REVERSE); y += 2

            stdscr.addstr(y, 0, "CPU", curses.A_BOLD | curses.color_pair(4)); y += 1
            stdscr.addstr(y, 2, f"temp {fmt(c['package_c'], ' C', 1):>8}", curses.color_pair(tcolor(c["package_c"])))
            stdscr.addstr(y, 20, f"power {fmt(c['power_w'], ' W', 1):>8}")
            stdscr.addstr(y, 38, f"freq {fmt(c['freq_mhz_avg'], ' MHz'):>9}")
            stdscr.addstr(y, 58, f"gov {str(c['governor'])}"); y += 1
            stdscr.addstr(y, 2, "temp  " + spark(hist["cpu_t"], sw, 105), curses.color_pair(tcolor(c["package_c"]))); y += 1
            stdscr.addstr(y, 2, "power " + spark(hist["cpu_w"], sw)); y += 1
            pl = {k["name"]: k for k in c["constraints"]}
            lt, st = pl.get("long_term"), pl.get("short_term")
            stdscr.addstr(y, 2, "PL1 " + (f"{lt['limit_w']:.0f} W" if lt else "--") +
                                "   PL2 " + (f"{st['limit_w']:.0f} W" if st else "--") +
                                f"   max_perf {fmt(c['max_perf_pct'], '%')}" +
                                f"   turbo {('on' if c['turbo'] else 'off') if c['turbo'] is not None else '--'}")
            y += 1
            if lt and lt["max_w"]:
                bar(stdscr, y, 2, 40, (c["power_w"] or 0) / max(lt["max_w"], 1), "  package load", tcolor(c["package_c"]))
                y += 1
            y += 1

            stdscr.addstr(y, 0, "GPU", curses.A_BOLD | curses.color_pair(5)); y += 1
            if g.get("name"):
                stdscr.addstr(y, 2, f"temp {fmt(g['temp_c'], ' C'):>8}", curses.color_pair(tcolor(g["temp_c"])))
                stdscr.addstr(y, 20, f"power {fmt(g['power_w'], ' W', 1):>8}")
                stdscr.addstr(y, 38, f"sm   {fmt(g['clock_sm_mhz'], ' MHz'):>9}")
                stdscr.addstr(y, 58, f"util {fmt(g['util_pct'], ' %')}"); y += 1
                stdscr.addstr(y, 2, "temp  " + spark(hist["gpu_t"], sw, 100), curses.color_pair(tcolor(g["temp_c"]))); y += 1
                stdscr.addstr(y, 2, "power " + spark(hist["gpu_w"], sw)); y += 1
                lim = g.get("power_limit_w")
                stdscr.addstr(y, 2, f"limit {fmt(lim, ' W')}   vram {fmt(g['mem_used_mb'], '')}/{fmt(g['mem_total_mb'], ' MB')}")
                y += 1
                if lim:
                    bar(stdscr, y, 2, 40, (g["power_w"] or 0) / max(lim, 1), "  gpu load", tcolor(g["temp_c"]))
                    y += 1
            else:
                stdscr.addstr(y, 2, "nvidia-smi unavailable"); y += 1
            y += 1

            stdscr.addstr(y, 0, "FANS", curses.A_BOLD | curses.color_pair(4)); y += 1
            if f["available"]:
                stdscr.addstr(y, 2, f"mode {str(f['mode']):>8}")
                stdscr.addstr(y, 20, f"duty  {fmt(f['pwm_pct'], ' %'):>8}")
                stdscr.addstr(y, 38, "rpm  " + "  ".join(f"{k}:{v}" for k, v in (f["rpm"] or {}).items()))
                y += 1
                stdscr.addstr(y, 2, "rpm   " + spark(hist["fan"], sw)); y += 1
                for k, v in (f["duty"] or {}).items():
                    bar(stdscr, y, 2, 40, v / 100, f"  {k} fan duty", 4); y += 1
                if f["ec_temps"]:
                    stdscr.addstr(y, 2, "ec temps  " + "  ".join(f"{k}:{v:.0f}C" for k, v in f["ec_temps"].items()))
                    y += 1
            else:
                stdscr.addstr(y, 2, "fan driver unavailable"); y += 1

            if y < h - 1:
                stdscr.addstr(h - 1, 0, " q quit   n normal   s silent   g gaming   1-9 fixed duty 10-90%  ",
                              curses.A_REVERSE)
            stdscr.refresh()

            t_end = time.time() + args.interval
            while time.time() < t_end:
                ch = stdscr.getch()
                if ch == -1:
                    time.sleep(0.05)
                    continue
                try:
                    if ch in (ord("q"), 27):
                        return
                    if ch == ord("n"):
                        FANS.set_mode("normal")
                    elif ch == ord("s"):
                        FANS.set_mode("silent")
                    elif ch == ord("g"):
                        FANS.set_mode("gaming")
                    elif ord("1") <= ch <= ord("9"):
                        FANS.set_speed_pct((ch - ord("0")) * 10)
                        FANS.set_mode("fixed")
                except Err:
                    curses.flash()
                break

    if not is_root():
        sys.stderr.write("note: running without root - the hotkeys that change fan mode will not work\n")
        time.sleep(1)
    curses.wrapper(draw)
    return 0


